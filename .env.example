# Copiá este archivo a .env.local y completá los valores reales.
# Estas variables las lee Vite en build/dev (deben empezar con VITE_).
#
# SON OBLIGATORIAS. Desde 2026-08-30 no hay valores por defecto: `npm run build`
# aborta si faltan y `src/lib/supabase.js` lanza al importarse. Antes caía a las
# credenciales de producción de la Fundación, y eso hacía que un proyecto mal
# configurado escribiera en la base equivocada sin fallar (ROADMAP 10.6 / 11.7).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
